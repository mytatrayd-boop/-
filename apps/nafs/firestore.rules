rules_version = '2';

// المعلم: حساب بريد وكلمة مرور. الطالب: دخول مجهول (anonymous) ثم قراءة سجله برقم السجل المدني فقط.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function provider() { return request.auth.token.firebase.sign_in_provider; }
    function isTeacher() { return signedIn() && provider() == 'password'; }
    function isStudentSession() { return signedIn() && provider() == 'anonymous'; }
    function isOwner(uid) { return isTeacher() && request.auth.uid == uid; }
    function text(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function civilId(v) { return v is string && v.matches('^[0-9]{10}$'); }

    match /teachers/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'civilId', 'school', 'className', 'email', 'createdAt'])
        && text(request.resource.data.name, 100)
        && civilId(request.resource.data.civilId)
        && text(request.resource.data.school, 120)
        && text(request.resource.data.className, 60);

      // الملفات المرفوعة (أكسل) محفوظة كنص base64 داخل المستند (الحد ~700KB للملف).
      match /uploads/{fileId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['name', 'size', 'type', 'data', 'className', 'added', 'createdAt'])
          && text(request.resource.data.name, 200)
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 950000
          && request.resource.data.size is int
          && request.resource.data.added is int;
      }
    }

    // مستند لكل طالب، معرّفه رقم السجل المدني. الطالب مسجل عند معلم واحد فقط.
    match /students/{sid} {
      allow get: if signedIn();
      allow list: if isTeacher() && resource.data.teacherUid == request.auth.uid;

      allow create: if isTeacher() && civilId(sid)
        && request.resource.data.keys().hasOnly(['name', 'teacherUid', 'className', 'school', 'status', 'createdAt'])
        && request.resource.data.teacherUid == request.auth.uid
        && text(request.resource.data.name, 100)
        && text(request.resource.data.className, 60);

      allow delete: if isTeacher() && resource.data.teacherUid == request.auth.uid;

      // الدرجات تُحسب من محاولات الاختبارات، فلا يكتب الطالب في سجله.
      allow update: if isTeacher()
        && resource.data.teacherUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'className', 'status', 'score', 'completedAt'])
        && text(request.resource.data.name, 100);
    }

    function testDoc(id) { return get(/databases/$(database)/documents/tests/$(id)).data; }
    function studentDoc(id) { return get(/databases/$(database)/documents/students/$(id)).data; }

    // اختبار يبنيه المعلم: نص + أسئلة مربوطة بالمهارات، بدون الإجابات الصحيحة.
    match /tests/{testId} {
      allow read: if (isTeacher() && resource.data.teacherUid == request.auth.uid)
        || (signedIn() && resource.data.status == 'published');
      allow delete: if isTeacher() && resource.data.teacherUid == request.auth.uid;
      allow create, update: if isTeacher()
        && request.resource.data.teacherUid == request.auth.uid
        && (resource == null || resource.data.teacherUid == request.auth.uid)
        && request.resource.data.keys().hasOnly(['teacherUid', 'title', 'className', 'grade', 'passage', 'questions', 'skills', 'status', 'createdAt', 'updatedAt'])
        && text(request.resource.data.title, 120)
        && text(request.resource.data.className, 60)
        && request.resource.data.grade in [3, 6, 9]
        && request.resource.data.passage is string && request.resource.data.passage.size() <= 20000
        && request.resource.data.questions is list
        && request.resource.data.questions.size() > 0 && request.resource.data.questions.size() <= 60
        && request.resource.data.skills is list
        && request.resource.data.status in ['draft', 'published'];
    }

    // الإجابات الصحيحة — للمعلم فقط.
    match /testKeys/{testId} {
      allow read, delete: if isTeacher() && resource.data.teacherUid == request.auth.uid;
      allow create, update: if isTeacher()
        && request.resource.data.teacherUid == request.auth.uid
        && (resource == null || resource.data.teacherUid == request.auth.uid)
        && request.resource.data.keys().hasOnly(['teacherUid', 'answers'])
        && request.resource.data.answers is list;
    }

    // محاولة طالب: معرّفها testId_studentId، تُكتب مرة واحدة، ويصححها المعلم بمفتاح الإجابات.
    match /attempts/{attemptId} {
      allow get: if signedIn() && (isStudentSession() || resource.data.teacherUid == request.auth.uid);
      allow list, delete: if isTeacher() && resource.data.teacherUid == request.auth.uid;
      allow create: if isStudentSession()
        && request.resource.data.keys().hasOnly(['testId', 'studentId', 'teacherUid', 'className', 'answers', 'submittedAt'])
        && attemptId == request.resource.data.testId + '_' + request.resource.data.studentId
        && civilId(request.resource.data.studentId)
        && request.resource.data.submittedAt == request.time
        && request.resource.data.answers is list
        && testDoc(request.resource.data.testId).status == 'published'
        && testDoc(request.resource.data.testId).teacherUid == request.resource.data.teacherUid
        && testDoc(request.resource.data.testId).className == request.resource.data.className
        && request.resource.data.answers.size() == testDoc(request.resource.data.testId).questions.size()
        && studentDoc(request.resource.data.studentId).teacherUid == request.resource.data.teacherUid
        && studentDoc(request.resource.data.studentId).className == request.resource.data.className;
    }
  }
}
