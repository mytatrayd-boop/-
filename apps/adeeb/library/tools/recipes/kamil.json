  "license": "CC BY-NC-SA 4.0",
  "removed": "حواشي المحقق (محمد أبو الفضل إبراهيم) ومقدمته وفهارسه حذفها OpenITI (عملية التنظيف 2023). حُذف هنا: أرقام حواشٍ ملتصقة بآخر الكلمة (مثل «فلقا2»)، وإحالة المحقق «[الشعراء: من الآية227]»، وعناوين المجلدات «المجلد الأول...» (3) وأسطر «...» وحدها (7)، ووسم span، وعلامات OpenITI (المعالم ms 625؛ وعلامات الصفحات 954 نُقلت إلى حقل page). قوسا الآية {} صارا (). زيادات الأخفش «[قال أبو الحسن: ...]» من الرواية القديمة فبقيت. وُصلت 246 فقرة شقّها حدّ الصفحة.",
  "merge_page_breaks": true,
  "skip_headings": [],
  "drop_lines": [
    {
      "name": "عنوان المجلد في الطبعة «# المجلد ...» (ليس من نص المؤلف)",
      "pattern": "# المجلد (الأول|الثاني|الثالث|الرابع)\\s*"
    },
    {
      "name": "سطر «...» وحده (علامة بلا نص)",
      "pattern": "# *\\.\\.\\.\\s*"
    }
  ],
  "rules": [
    {
      "name": "وسم HTML span بلا نص (بقايا تحويل الشاملة)",
      "pattern": "</?span[^>]*>"
    },
    {
      "name": "رقم حاشية «1» في عنوان «باب 1 اللام»",
      "pattern": "(### \\| باب) 1 (اللام)",
      "with": "$1 $2"
    },
    {
      "name": "فاصل * في «[زاد أبو الحسن: * ...]»",
      "pattern": "(زاد أبو الحسن:) \\* ",
      "with": "$1 "
    },
    {
      "name": "قوس بداية الآية «{» (اصطلاح الشاملة) ← «(»",
      "pattern": "\\{",
      "with": "("
    },
    {
      "name": "قوس نهاية الآية «}» (اصطلاح الشاملة) ← «)»",
      "pattern": "\\}",
      "with": ")"
    },
    {
      "name": "%~% خاطئ داخل نثر «ابن أمير ابن أمير %~% قال»",
      "pattern": "(ابن أمير ابن أمير) %~% (قال: حتى عددت)",
      "with": "$1 $2"
    },
    {
      "name": "رقم حاشية ملتصق بآخر كلمة (مثل «فلقا2»)",
      "pattern": "(?<=[ء-ي])[0-9](?![0-9])"
    },
    {
      "name": "إحالة المحقق إلى الآية «[الشعراء: من» (سطرها الأول)",
      "pattern": " ?\\[الشعراء: من\\s*$"
    },
    {
      "name": "إحالة المحقق إلى الآية «الآية227]» (سطرها الثاني)",
      "pattern": "^~~الآية227\\] ?",
      "with": "~~"
    }
  ],
  "headings": {}
}
