// إعداد الخادم الوسيط لـ «الأديب الذكي» (ARCHITECTURE §8).
// لا أسرار هنا أبداً: GEMINI_API_KEY وDEVICE_SALT وIP_SALT عبر `wrangler secret put`
// (ومحلياً في .dev.vars غير المرفوع).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adeeb-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,

  "durable_objects": {
    "bindings": [{ "name": "COUNTERS", "class_name": "CounterStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CounterStore"] }],

  // حد بالدقيقة لكل جهاز ولكل IP (ARCHITECTURE §8.4). namespace_id رقم فريد في الحساب.
  "ratelimits": [
    { "name": "RL_DEVICE", "namespace_id": "4101", "simple": { "limit": 3, "period": 60 } },
    { "name": "RL_IP", "namespace_id": "4102", "simple": { "limit": 10, "period": 60 } }
  ],

  // إعدادات تتغير بلا تحديث التطبيق (D14). اضبط DAILY_GLOBAL على ≈90% من الحد
  // اليومي للنموذج كما يظهر في AI Studio.
  "vars": {
    "GEMINI_MODEL": "gemini-flash-lite-latest",
    "GEMINI_API_BASE": "https://generativelanguage.googleapis.com",
    "GEMINI_TIMEOUT_MS": "12000",
    "DAILY_PER_DEVICE": "10",
    "DAILY_PER_IP": "30",
    "DAILY_GLOBAL": "450",
    "MIN_CLIENT": "1",
    "MAX_BODY_BYTES": "32768",
    "MAX_QUESTION_CHARS": "500",
    "MAX_PASSAGES": "6",
    "MAX_PASSAGE_CHARS": "1500",
    "MAX_PASSAGES_TOTAL_CHARS": "8000",
    "MAX_ANSWER_CHARS": "800"
  },

  // السجلات: سطر واحد لكل طلب (المسار، الحالة، الزمن، الرمز). سجلات الاستدعاء
  // التلقائية معطّلة لأنها قد تحمل الترويسات (المعرّف وIP).
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
