<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="موعد"
        android:textColor="#1C2B4B"
        android:textSize="16sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="اختر المواعيد من التطبيق: تخصيص ← ودجت الشاشة الرئيسية"
        android:textColor="#5E6A80"
        android:textSize="13sp"
        android:visibility="gone"/>

    <LinearLayout android:id="@+id/row0" style="@style/MawidRow">
        <TextView android:id="@+id/name0" style="@style/MawidName"/>
        <TextView android:id="@+id/days0" style="@style/MawidDays"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/row1" style="@style/MawidRow">
        <TextView android:id="@+id/name1" style="@style/MawidName"/>
        <TextView android:id="@+id/days1" style="@style/MawidDays"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/row2" style="@style/MawidRow">
        <TextView android:id="@+id/name2" style="@style/MawidName"/>
        <TextView android:id="@+id/days2" style="@style/MawidDays"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/row3" style="@style/MawidRow">
        <TextView android:id="@+id/name3" style="@style/MawidName"/>
        <TextView android:id="@+id/days3" style="@style/MawidDays"/>
    </LinearLayout>
</LinearLayout>
