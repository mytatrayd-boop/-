<?xml version="1.0" encoding="utf-8"?>
<!-- مربع أعمدة (الميزة ٦، _ColumnsTile): مواقيت الصلاة (خمسة أعمدة، صندوق أفتح) والإيداعات («متبقي
     على:» ثم حتى ثلاثة أعمدة). كل عمود اسم ٢٠ عريض وتحته سطر ١٦، من اليمين؛ الأعمدة الزائدة GONE.
     الأحجام من fitColumns في LamhaWidgetReceiver. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tile_box"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/tile_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/tile_bg"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/columns_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="right|center_vertical"
            android:textDirection="rtl"
            android:includeFontPadding="false"
            android:fallbackLineSpacing="false"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#66000000"
            android:shadowRadius="3"
            android:textColor="#FFB9B0A2"
            android:textSize="11sp" android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/columns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/col0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/col_name0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="right|center_vertical"
                    android:textDirection="rtl"
                    android:includeFontPadding="false"
                    android:fallbackLineSpacing="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowRadius="3"
                    android:textColor="#FFF4EFE6"
                    android:textSize="20sp" android:textStyle="bold" />
                <TextView
                    android:id="@+id/col_sub0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="right|center_vertical"
                    android:textDirection="rtl"
                    android:includeFontPadding="false"
                    android:fallbackLineSpacing="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowRadius="3"
                    android:textColor="#FFB9B0A2"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/col1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/col_name1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="right|center_vertical"
                    android:textDirection="rtl"
                    android:includeFontPadding="false"
                    android:fallbackLineSpacing="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowRadius="3"
                    android:textColor="#FFF4EFE6"
                    android:textSize="20sp" android:textStyle="bold" />
                <TextView
                    android:id="@+id/col_sub1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="right|center_vertical"
                    android:textDirection="rtl"
                    android:includeFontPadding="false"
                    android:fallbackLineSpacing="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowRadius="3"
                    android:textColor="#FFB9B0A2"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/col2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/col_name2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="right|center_vertical"
                    android:textDirection="rtl"
                    android:includeFontPadding="false"
                    android:fallbackLineSpacing="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowRadius="3"
                    android:textColor="#FFF4EFE6"
                    android:textSize="20sp" android:textStyle="bold" />
                <TextView
                    android:id="@+id/col_sub2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="right|center_vertical"
                    android:textDirection="rtl"
                    android:includeFontPadding="false"
                    android:fallbackLineSpacing="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowRadius="3"
                    android:textColor="#FFB9B0A2"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/col3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/col_name3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="right|center_vertical"
                    android:textDirection="rtl"
                    android:includeFontPadding="false"
                    android:fallbackLineSpacing="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowRadius="3"
                    android:textColor="#FFF4EFE6"
                    android:textSize="20sp" android:textStyle="bold" />
                <TextView
                    android:id="@+id/col_sub3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="right|center_vertical"
                    android:textDirection="rtl"
                    android:includeFontPadding="false"
                    android:fallbackLineSpacing="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowRadius="3"
                    android:textColor="#FFB9B0A2"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/col4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/col_name4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="right|center_vertical"
                    android:textDirection="rtl"
                    android:includeFontPadding="false"
                    android:fallbackLineSpacing="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowRadius="3"
                    android:textColor="#FFF4EFE6"
                    android:textSize="20sp" android:textStyle="bold" />
                <TextView
                    android:id="@+id/col_sub4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="right|center_vertical"
                    android:textDirection="rtl"
                    android:includeFontPadding="false"
                    android:fallbackLineSpacing="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowRadius="3"
                    android:textColor="#FFB9B0A2"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
