<?xml version="1.0" encoding="utf-8"?>
<!-- الإيداعات (طلب المالك، _DepositsTile): كل إيداع في مستطيل (deposit_bg)، الاسم ١٦ عادي وبجانبه الأيام ١٦
     في عمود بعرض أعرضها (كجدول)، الأقرب أولاً من اليمين. عمود حتى ثلاثة وعمودان بعدها؛ الصفوف والخانات
     الزائدة مخفية. الأحجام من fitGrid في LamhaWidgetReceiver. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tile_box"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical">

        <LinearLayout
            android:id="@+id/grid_row0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/grid_cell0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/deposit_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:baselineAligned="true"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/grid_name0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:textDirection="rtl"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:fallbackLineSpacing="false"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowRadius="3"
                    android:textColor="#FFF4EFE6"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/grid_days0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:gravity="right|center_vertical"
                    android:textDirection="rtl"
                    android:includeFontPadding="false"
                    android:fallbackLineSpacing="false"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowRadius="3"
                    android:textColor="#FFB9B0A2"
                    android:textSize="16sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/grid_cell1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
