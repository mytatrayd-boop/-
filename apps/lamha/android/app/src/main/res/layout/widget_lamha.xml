<?xml version="1.0" encoding="utf-8"?>
<!-- الودجت الكبيرة ٤×٤ (الميزة ٥): RemoteViews عادية. مطابقة للمعاينة في
     lib/src/app/widget_preview.dart، وهي المرجع. الشبكة صفوف (widget_row) تملؤها
     LamhaWidgetReceiver من `layout` في الجدول بـ addView، وفي كل صف خانات بعرض ١ أو ٢ أو ٣
     (widget_tile*.xml) داخل كل منها محتوى مربعها. من اليمين لليسار بالترتيب المنطقي
     (الأول = الأيمن). حشوة الشبكة ١٠ + حشوة الخانة ٤ = ١٤ كالمعاينة. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <!-- إطار الخلفية الحر (DECISIONS ٣٠): حشوة الغلاف (setViewPadding من الجدول) تحدد مكان لوحة الخلفية ومقاسها
         وحدها؛ الشبكة والمربعات العائمة تبقى على الودجت كلها فلا تتحرك ولا يتغير مقاسها. -->
    <LinearLayout
        android:id="@+id/bg_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_bg"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <!-- لوحة العناصر الثابتة (DECISIONS ٣٠، اختيار المالك ١٣ نوفمبر): الشبكة والمربعات العائمة في لوحة بمقاس ثابت
         (setViewLayoutWidth/Height من الكود، أندرويد ١٢+) متوسطة في الودجت. تكبير الودجت أو تصغيرها من
         الشاشة الرئيسية يغيّر الخلفية وحدها؛ العناصر لا تكبر ولا تصغر، ويُقصّ ما يخرج عن الإطار. -->
    <FrameLayout
        android:id="@+id/canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <LinearLayout
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="10dp" />

        <!-- المربعات العائمة (DECISIONS ٢٩): تُمسح وتُضاف في كل تحديث، فلا تتراكم نسخ قديمة فوق بعضها. -->
        <FrameLayout
            android:id="@+id/float_layer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</FrameLayout>
