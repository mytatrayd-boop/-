<?xml version="1.0" encoding="utf-8"?>
<!-- الودجت الكبيرة ٤×٤ (الميزة ٣ج): RemoteViews عادية. مطابقة للمعاينة في
     lib/src/app/widget_preview.dart، وهي المرجع. من اليمين لليسار بالترتيب المنطقي
     (الأول = الأيمن). الألوان والنصوص والمربعات من LamhaWidgetReceiver. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!-- الصف العلوي: يميناً الساعة و«ص/م» وتحتهما اليوم، ويساراً الهجري والميلادي والمدينة والطقس. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="right"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <!-- ساعة النظام بلا «ص/م»: تتحدث كل دقيقة دون تحديث الودجت. -->
                    <TextClock
                        android:gravity="right|center_vertical"
                        android:textDirection="rtl"
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="h:mm"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:shadowColor="#66000000"
                        android:shadowRadius="3"
                        android:textColor="#FFF4EFE6"
                        android:textSize="42sp"
                        android:textStyle="bold" />

                    <TextView
                        android:gravity="right|center_vertical"
                        android:textDirection="rtl"
                        android:id="@+id/am_pm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:maxLines="1"
                        android:shadowColor="#66000000"
                        android:shadowRadius="3"
                        android:textColor="#FFF4EFE6"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:gravity="right|center_vertical"
                    android:textDirection="rtl"
                    android:id="@+id/weekday"
                    android:layout_gravity="right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowRadius="3"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left|top"
                    android:orientation="vertical">
                    <!-- عمود أيسر، ونصوصه محاذاة يمين داخله (عرض match_parent = أعرض سطر). -->

                    <TextView
                        android:gravity="right|center_vertical"
                        android:textDirection="rtl"
                        android:id="@+id/hijri"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:shadowColor="#66000000"
                        android:shadowRadius="3"
                        android:textColor="#FFF4EFE6"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:gravity="right|center_vertical"
                        android:textDirection="rtl"
                        android:id="@+id/gregorian"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:shadowColor="#66000000"
                        android:shadowRadius="3"
                        android:textColor="#FFCFC6B8"
                        android:textSize="13sp" />

                    <TextView
                        android:gravity="right|center_vertical"
                        android:textDirection="rtl"
                        android:id="@+id/weather"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:shadowColor="#66000000"
                        android:shadowRadius="3"
                        android:textColor="#FFCFC6B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#14FFFFFF" />

        <!-- الشبكة: صفان تملؤهما LamhaWidgetReceiver بالمربعات الظاهرة كما في gridRows. -->
        <LinearLayout
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/row1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/row2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:orientation="horizontal" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
