<?xml version="1.0" encoding="utf-8"?>
<!-- الودجت الكبيرة ٤×٤ (الميزة ٥): RemoteViews عادية. مطابقة للمعاينة في
     lib/src/app/widget_preview.dart، وهي المرجع. الشبكة صفوف (widget_row) تملؤها
     LamhaWidgetReceiver من `layout` في الجدول بـ addView، وفي كل صف خانات بعرض ١ أو ٢ أو ٣
     (widget_tile*.xml) داخل كل منها محتوى مربعها. من اليمين لليسار بالترتيب المنطقي
     (الأول = الأيمن). حشوة الشبكة ١٠ + حشوة الخانة ٤ = ١٤ كالمعاينة. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp" />

    <!-- البوصلة الحرة (DECISIONS ٢٩): فوق الشبكة. الغلاف لا يلتقط اللمس ولا يظهر إلا مع float، وحشوته
         (setViewPadding من الجدول) تترك للصورة مكانها ومقاسها فقط، فيبقى ما حولها قابلاً للضغط. -->
    <LinearLayout
        android:id="@+id/float_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ImageView
            android:id="@+id/float_dial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitStart" />
    </LinearLayout>
</FrameLayout>
