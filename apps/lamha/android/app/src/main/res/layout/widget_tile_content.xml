<?xml version="1.0" encoding="utf-8"?>
<!-- محتوى المربع (_Tile في widget_preview.dart): العنوان ١٢ عريض والرمز، ثم القيمة ١٧ عريض،
     ثم الثانوي ١٢. العنوان والقيمة بلا قص، والثانوي وحده بحد أسطر و«…». استثناء مربع الإيداع مع
     إيداعين: القيمة سطر واحد بـ«…» (setMaxLines من Kotlin)، والإيداع الثاني (sub2) بحجم ١١. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tile_box"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/tile_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/tile_bg"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:gravity="right|center_vertical"
                android:textDirection="rtl"
                android:id="@+id/tile_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:shadowColor="#66000000"
                android:shadowRadius="3"
                android:textColor="#FFB9B0A2"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:gravity="right|center_vertical"
                android:textDirection="rtl"
                android:id="@+id/tile_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:gravity="right|center_vertical"
            android:textDirection="rtl"
            android:id="@+id/tile_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:shadowColor="#66000000"
            android:shadowRadius="3"
            android:textColor="#FFF4EFE6"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:gravity="right|center_vertical"
            android:textDirection="rtl"
            android:id="@+id/tile_sub1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#66000000"
            android:shadowRadius="3"
            android:textColor="#FFB9B0A2"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- عدّاد النظام التنازلي للصلاة القادمة. -->
        <Chronometer
            android:gravity="right|center_vertical"
            android:textDirection="rtl"
            android:id="@+id/tile_countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:shadowColor="#66000000"
            android:shadowRadius="3"
            android:textColor="#FFB9B0A2"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:gravity="right|center_vertical"
            android:textDirection="rtl"
            android:id="@+id/tile_sub2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#66000000"
            android:shadowRadius="3"
            android:textColor="#FFB9B0A2"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:gravity="right|center_vertical"
            android:textDirection="rtl"
            android:id="@+id/tile_sub3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:shadowColor="#66000000"
            android:shadowRadius="3"
            android:textColor="#FFB9B0A2"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
