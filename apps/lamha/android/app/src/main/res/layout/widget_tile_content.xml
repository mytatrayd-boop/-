<?xml version="1.0" encoding="utf-8"?>
<!-- محتوى مربعات المعلومات الخمسة (_Tile في widget_preview.dart، الميزة ٣د، بلا رموز): العنوان ١٣ عريض، ثم القيمة
     ٢٠ عريض، ثم الثانوي ١٤، كلها × معامل الخط من LamhaWidgetReceiver. العنوان والقيمة سطر واحد
     يصغر خطه ليتسع (fitTextSize) ثم «…»، والثانوي بحد أسطر و«…» (الأخير يأخذ ما يتسع). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tile_box"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/tile_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/tile_bg"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:gravity="right|center_vertical"
            android:textDirection="rtl"
            android:id="@+id/tile_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:shadowColor="#66000000"
            android:shadowRadius="3"
            android:textColor="#FFB9B0A2"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:gravity="right|center_vertical"
            android:textDirection="rtl"
            android:id="@+id/tile_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:shadowColor="#66000000"
            android:shadowRadius="3"
            android:textColor="#FFF4EFE6"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:gravity="right|center_vertical"
            android:textDirection="rtl"
            android:id="@+id/tile_sub1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#66000000"
            android:shadowRadius="3"
            android:textColor="#FFB9B0A2"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- عدّاد النظام التنازلي للصلاة القادمة. -->
        <Chronometer
            android:gravity="right|center_vertical"
            android:textDirection="rtl"
            android:id="@+id/tile_countdown"
            android:singleLine="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:shadowColor="#66000000"
            android:shadowRadius="3"
            android:textColor="#FFB9B0A2"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:gravity="right|center_vertical"
            android:textDirection="rtl"
            android:id="@+id/tile_sub2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#66000000"
            android:shadowRadius="3"
            android:textColor="#FFB9B0A2"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:gravity="right|center_vertical"
            android:textDirection="rtl"
            android:id="@+id/tile_sub3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:shadowColor="#66000000"
            android:shadowRadius="3"
            android:textColor="#FFB9B0A2"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
