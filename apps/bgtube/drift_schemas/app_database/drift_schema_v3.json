  "fixed_sql": [
    {
      "name": "positions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"positions\" (\"video_id\" TEXT NOT NULL, \"position_ms\" INTEGER NOT NULL, \"duration_ms\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"video_id\"));"
        }
      ]
    },
    {
      "name": "queue_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"queue_entries\" (\"key\" INTEGER NOT NULL, \"ord\" INTEGER NOT NULL, \"video_id\" TEXT NOT NULL, \"title\" TEXT NULL, \"author\" TEXT NULL, \"duration_ms\" INTEGER NULL, \"thumb_url\" TEXT NULL, \"failed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"failed\" IN (0, 1)), PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "queue_state",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"queue_state\" (\"id\" INTEGER NOT NULL CHECK(\"id\" = 0), \"current_key\" INTEGER NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "local_playlists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_playlists\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "local_playlist_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_playlist_items\" (\"playlist_id\" INTEGER NOT NULL REFERENCES local_playlists (id) ON DELETE CASCADE, \"ord\" INTEGER NOT NULL, \"video_id\" TEXT NOT NULL, \"title\" TEXT NULL, \"author\" TEXT NULL, \"duration_ms\" INTEGER NULL, \"thumb_url\" TEXT NULL, PRIMARY KEY (\"playlist_id\", \"ord\"));"
        }
      ]
    },
    {
      "name": "api_cache",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"api_cache\" (\"key\" TEXT NOT NULL, \"json\" TEXT NOT NULL, \"fetched_at\" INTEGER NOT NULL, \"ttl_sec\" INTEGER NOT NULL, \"private\" INTEGER NOT NULL DEFAULT 0 CHECK (\"private\" IN (0, 1)), PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "quota",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"quota\" (\"day_pt\" TEXT NOT NULL, \"units\" INTEGER NOT NULL, PRIMARY KEY (\"day_pt\"));"
        }
      ]
    }
  ]
