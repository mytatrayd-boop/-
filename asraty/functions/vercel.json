{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "bom1"
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/[name].js": {
      "maxDuration": 30,
      "includeFiles": "build/src/**"
    },
    "api/ping.js": {
      "maxDuration": 5
    }
  }
}
