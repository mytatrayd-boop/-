# أسعار السوق الأمريكي كامل — مفتاح مجاني من https://massive.com (Polygon سابقًا)
MASSIVE_API_KEY=

# الأخبار وتقويم الأرباح — مفتاح مجاني من https://www.alphavantage.co/support/#api-key
# (بدون Massive يُستخدم أيضًا لأسعار «قائمتي» بحد 25 سهم)
ALPHA_VANTAGE_KEY=

# بدون أي مفتاح يشتغل الخادم في "وضع تجريبي" ببيانات مصطنعة موسومة بوضوح.

# مجلد تخزين تاريخ الأسعار (~1MB لكل يوم تداول). على الاستضافة اربطه بقرص دائم
# وإلا تُعاد التعبئة الأولى (~15 دقيقة) بعد كل إعادة تشغيل.
DATA_DIR=./data
PORT=3000
